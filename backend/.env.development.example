# Local development defaults (do NOT commit real secrets)

# Django
DEBUG=1
SECRET_KEY=dev-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
INCLUDE_DEV_CORS_ORIGINS=1
CORS_ALLOW_ALL=1

# Database
DB_NAME=yoloapp
DB_USER=yolo
DB_PASSWORD=yolo_pass
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Model weights (override if your paths differ)
MODEL_SPIKE=./models/spike.pt
MODEL_SPIKELET=./models/spikelet.pt
MODEL_FHB=./models/fhb.pt
MODEL_FDK=./models/fdk.pt
MODEL_KERNEL=./models/kernel.pt
