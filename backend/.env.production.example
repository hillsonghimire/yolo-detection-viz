# Copy this file to backend/.env.production (or backend/.env) and adjust values
# before deploying. Keep real secrets out of version control.

# Django settings
DEBUG=0
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_50_CHAR_SECRET
ALLOWED_HOSTS=wheatai.net,www.wheatai.net
CSRF_TRUSTED_ORIGINS=https://wheatai.net,https://www.wheatai.net
CORS_ALLOWED_ORIGINS=https://wheatai.net,https://www.wheatai.net
CORS_ALLOW_ALL=0
INCLUDE_DEV_CORS_ORIGINS=0  # set to 1 if you need localhost/127.0.0.1 during staging

# HTTPS hardening
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# Database (adjust to your managed Postgres)
DB_NAME=yoloapp
DB_USER=yolo
DB_PASSWORD=yolo_pass
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery / Redis (example when using local Redis)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
