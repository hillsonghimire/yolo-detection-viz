# Copy this to frontend/.env.production (or frontend/.env) and adjust the URL
# to match your public backend origin. Do not commit real secrets.

VITE_API_BASE=https://wheatai.net
# Leave VITE_API_PORT empty when using the default HTTPS port (443)
VITE_API_PORT=
VITE_API_TIMEOUT_MS=180000

# After updating this file run:
#   docker compose -f docker-compose-prod.yml --profile build run --rm frontend-build
# to rebuild frontend/dist for production.
